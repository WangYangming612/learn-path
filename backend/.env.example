# 数据库连接 URL
# What: SQLAlchemy 异步数据库连接字符串
# Why: 开发阶段使用 SQLite（无需安装数据库服务），生产环境切换 PostgreSQL
DATABASE_URL="sqlite+aiosqlite:///./data/sqlite/app.db"

# 应用密钥
# What: 用于 JWT 令牌签名和敏感数据加密的密钥
# Why: 必须设置为随机字符串，泄漏会导致安全风险
SECRET_KEY="change-this-to-a-random-secret-key"

# LLM 服务 API 密钥
# What: 调用大语言模型服务的认证密钥
# Why: 多智能体系统依赖 LLM 进行路径生成、反馈分析等核心能力
LLM_API_KEY="sk-your-api-key"

# LLM 服务基础地址
# What: LLM API 的请求端点
# Why: 默认使用 OpenAI 兼容接口，可切换为 DeepSeek/Ollama 等其他服务
LLM_BASE_URL="https://api.openai.com/v1"

# LLM 模型名称
LLM_MODEL="gpt-4o-mini"

# LLM 服务配置
OPENAI_API_KEY="sk-your-api-key"
OPENAI_BASE_URL="https://api.openai.com/v1"
